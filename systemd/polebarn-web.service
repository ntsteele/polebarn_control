[Unit]
Description=Polebarn Web Control + XR18 shortcuts
After=network-online.target
Wants=network-online.target
[Service]
User=pi
Group=pi
Environment=VIRTUAL_ENV=/home/pi/polebarn-venv
Environment=PATH=/home/pi/polebarn-venv/bin:/usr/bin
WorkingDirectory=/home/pi/polebarn_control
ExecStart=/home/pi/polebarn-venv/bin/python /home/pi/polebarn_control/web_control.py
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
